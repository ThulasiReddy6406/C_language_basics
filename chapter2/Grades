#include<stdio.h>

int main(){

    int marks;
    printf("Enter your marks:- ");
    scanf("%d",&marks);

    if (marks>=90)
    {
        printf("%d - A+",marks);
    }else if (marks<90 && marks>=70)
    {
        printf("%d - A",marks);
    }else{
        printf("%d - B",marks);
    }
    
    
    
}
