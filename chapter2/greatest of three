#include<stdio.h>

int main(){

    int a,b,c;
    printf("Enter 1st number:- ");
    scanf("%d",&a);
    printf("Enter 2nd number:- ");
    scanf("%d",&b);
    printf("Enter 3rd number:- ");
    scanf("%d",&c);

    if(a>b && a>c){
        printf("A[%d]is a greatest number",a);
    }
    else if (b>a && b>c)
    {
        printf("B[%d]is a greatest number",b);
    }
    else
    {
        printf("C[%d]is a greatest number",c);
    }
    return 0;
    

}
